# =============================================================================
# 1) Copiá este archivo a `.env` y completá valores reales.
# 2) NO subas `.env` a git (está en .gitignore).
# 3) El bot y flask_dashboard cargan `.env` automáticamente (python-dotenv).
#    Si ya definiste una variable en PowerShell, esa tiene prioridad.
# =============================================================================

# --- MT5 (obligatorio) ---
MT5_LOGIN=<ACCOUNT_LOGIN>
MT5_PASSWORD=<ACCOUNT_PASSWORD>
MT5_SERVER=<SERVER_NAME>
# Ejemplo demo IC Markets: ICMarketsSC-Demo (verificá en tu correo/portal el servidor exacto)

# --- Telegram (opcional): alertas si MT5 se cae / errores en el loop / arranque y parada / prueba en dashboard ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_START=1
# TELEGRAM_NOTIFY_STOP=1
# TELEGRAM_NOTIFY_SIGNALS=0      # si 1: avisar cuando haya señal BUY/SELL (anti-spam ~15 min por símbolo)
# TELEGRAM_NOTIFY_TRADE_OPEN=1   # aviso al abrir orden (entrada)
# TELEGRAM_NOTIFY_TRADE_CLOSE=1  # aviso al cerrar (SL/TP/manual, PnL del deal)
# TELEGRAM_NOTIFY_SESSION_WINDOW=1  # aviso al inicio/fin de ventana horaria por instrumento
# TELEGRAM_NOTIFY_WATCHER_SL=1   # aviso cuando el watcher modifica el SL (dedup por ticket+SL)
# TELEGRAM_TIMEOUT=12

# --- Símbolos (comma-separated) ---
# Parallel demo (post MQL5 mining): BTCUSD,EURUSD,USDJPY + XAUUSD parallel.
# BOT_SYMBOLS=BTCUSD,EURUSD,USDJPY
BOT_SYMBOLS=

# --- Estrategia XAUUSD en paralelo (independiente del loop principal) ---
# Breakout M15 (misma lógica que el scan IS/OOS PF 1.12/1.26). NO usar scalp EMA9/21 (PF OOS ~0.70).
# SL/TP ATR×1.5 / RR≥1.5 al broker. Código clampa TP_RR<1.5 y ADX<22.
# BOT_XAUUSD_PARALLEL_ENABLED=1
# BOT_XAUUSD_PARALLEL_SYMBOL=XAUUSD
# BOT_XAUUSD_PARALLEL_MAGIC=260415
# BOT_XAUUSD_PARALLEL_LOT=0.01
# BOT_XAUUSD_PARALLEL_ENTRY_MODE=breakout
# BOT_XAUUSD_PARALLEL_SL_MODE=atr
# BOT_XAUUSD_PARALLEL_SL_ATR_MULT=1.5
# BOT_XAUUSD_PARALLEL_TP_RR=2.0
# BOT_XAUUSD_PARALLEL_SL_ATR_MIN=1.5
# BOT_XAUUSD_PARALLEL_ATR_PERIOD=14
# BOT_XAUUSD_PARALLEL_ADX_MIN=25
# BOT_XAUUSD_PARALLEL_H1_FILTER=1
# BOT_XAUUSD_PARALLEL_H4_FILTER=1
# BOT_XAUUSD_PARALLEL_H1_EMA_PERIOD=20
# BOT_XAUUSD_PARALLEL_SL_MONEY=2.00
# BOT_XAUUSD_PARALLEL_TP_MONEY=2.00
# Ventanas ART: overlap Londres/NY (10–16, incluye hora UTC 17) + 19–21. Flatten fuera de ventana.
# BOT_XAUUSD_PARALLEL_SESSIONS=10:00-16:00,19:00-21:00
# BOT_XAUUSD_PARALLEL_START_HOUR=10
# BOT_XAUUSD_PARALLEL_END_HOUR=16
# BOT_XAUUSD_PARALLEL_FLATTEN_OUTSIDE_WINDOW=1
# BOT_XAUUSD_PARALLEL_ANTI_CHASE=1
# BOT_XAUUSD_PARALLEL_ANTI_CHASE_ATR_MULT=2.0
# Chase: vela >1.5×ATR cerrando en el 20% extremo; precio >1×ATR vs EMA; spike M1 >0.8×ATR.
# BOT_XAUUSD_PARALLEL_EXHAUSTION_ATR_MULT=1.5
# BOT_XAUUSD_PARALLEL_EXHAUSTION_EXTREME_FRAC=0.20
# BOT_XAUUSD_PARALLEL_EXTENSION_ATR_MAX=1.0
# BOT_XAUUSD_PARALLEL_M1_SPIKE_ATR_MULT=0.80
# BOT_XAUUSD_PARALLEL_MAX_POSITIONS=1
# BOT_XAUUSD_PARALLEL_MAX_SPREAD_POINTS=55
# BOT_XAUUSD_PARALLEL_COOLDOWN_SECONDS=300
# BOT_XAUUSD_PARALLEL_ONE_TRADE_PER_BAR=1
# BOT_XAUUSD_PARALLEL_SL_SPREAD_BUFFER=1

# Opcional: magic de las órdenes del bot (default en código: 260414).
# BOT_MAGIC=260414

# --- Operación base ---
BOT_LOT=0.01
BOT_POLL_SECONDS=30
# Entre ciclos completos (poll), volver a leer posiciones y ajustar SL/TP al menos cada N segundos.
BOT_MANAGE_POSITIONS_INTERVAL_SECONDS=5
BOT_MAX_OPEN_TRADES=5
BOT_MAX_OPEN_TRADES_TOTAL=5
BOT_DAILY_LOSS_LIMIT=-60.0

# --- Monthly loss limit (Elder's 6% Rule) ---
# Al superar `pct%` del balance al inicio del mes (loss realizado +
# riesgo abierto si se incluye), el bot deja de abrir trades hasta
# el 1 del próximo mes. Si include_open_risk=true, suma la pérdida
# potencial si cada posición abierta llega a su SL (más conservador,
# pero requiere SL definido en todas las posiciones).
BOT_MONTHLY_LOSS_LIMIT_ENABLED=true
BOT_MONTHLY_LOSS_LIMIT_PCT=6.0
BOT_MONTHLY_LOSS_LIMIT_INCLUDE_OPEN_RISK=true

# --- Pyramiding (varias órdenes por mismo activo) ---
# 1 = desactivado. >1 = permitir hasta N posiciones por símbolo (recomendado <=3).
BOT_MAX_POSITIONS_PER_SYMBOL=1
# 1 = sólo abrir nueva capa si TODAS las posiciones previas en el símbolo ya tienen SL en BE o mejor.
BOT_PYRAMIDING_REQUIRE_BE=1
# Distancia mínima en points respecto al último entry mismo-lado para abrir nueva capa (0 = off).
BOT_PYRAMIDING_MIN_SEPARATION_POINTS=0
# Override por símbolo: agregar "max_positions_per_symbol", "pyramiding_require_be" o
# "pyramiding_min_separation_points" dentro de BOT_SYMBOL_CONFIG si querés ajustar por activo.

# --- SL/TP en points (recomendado con risk sizing; alineado con portfolio_backtest) ---
BOT_SL_POINTS=80
BOT_TP_POINTS=160

# --- Per-symbol overrides (JSON en UNA línea; vacío = usar defaults globales) ---
# Soporta (entre otros): sl_money/tp_money, sl_points/tp_points, max_spread_points, adx_min, ema_fast_m15/ema_slow_m15,
# cooldown_minutes, use_risk_sizing, risk_per_trade_pct, max_trades_per_hour_per_symbol, open_sl_at_entry_min_extra_points,
# anti_chase_atr_mult, price_slope_filter_enabled, price_slope_n
# Ejemplo:
# {"XAUUSD":{"sl_points":120,"tp_points":240,"max_spread_points":50,"adx_min":22}}
# BTC en MT5 suele usar point=0.01: SL/TP en miles de points; max_spread alto (spread demo ~1300+ points).
# BTC: risk_per_trade_pct opcional (solo BTC) si el global es alto y la cuenta es chica (margen).
BOT_SYMBOL_CONFIG={"BTCUSD":{"sl_points":40000,"tp_points":80000,"max_spread_points":5000,"risk_per_trade_pct":12,"adx_min":17,"break_even_trigger_money":25,"trail_trigger_money":50,"trail_new_sl_money":25,"trail_new_tp_money":60,"sl_tp_atr_enabled":false,"sl_atr_mult":1.5,"sl_tp_atr_min_points":12000},"ETHUSD":{"sl_points":12000,"tp_points":24000,"max_spread_points":5000,"risk_per_trade_pct":12,"adx_min":18,"break_even_trigger_money":25,"trail_trigger_money":50,"trail_new_sl_money":25,"trail_new_tp_money":60,"sl_tp_atr_enabled":true,"sl_atr_mult":1.5,"sl_tp_atr_min_points":400},"XAUUSD":{"max_spread_points":55,"sl_tp_atr_enabled":false,"sl_atr_mult":1.5,"sl_tp_atr_min_points":600},"GBPUSD":{"sl_tp_atr_enabled":false,"sl_atr_mult":1.5,"sl_tp_atr_min_points":45},"USDJPY":{"sl_tp_atr_enabled":false,"sl_atr_mult":1.5,"sl_tp_atr_min_points":50},"NZDJPY":{"sl_tp_atr_enabled":false,"sl_atr_mult":1.5,"sl_tp_atr_min_points":40}}

# --- Portfolio mode (pesos) ---
BOT_PORTFOLIO_ENABLED=1
BOT_PORTFOLIO_WEIGHTS={"GBPUSD":0.1667,"USDJPY":0.1667,"NZDJPY":0.1667,"XAUUSD":0.1667,"BTCUSD":0.1666,"ETHUSD":0.1666}

# --- Portfolio dinámico (live): rebalance por PnL realizado (history deals) ---
BOT_PORTFOLIO_DYNAMIC_ENABLED=0
BOT_PORTFOLIO_DYNAMIC_LOOKBACK_DAYS=14
BOT_PORTFOLIO_DYNAMIC_REBALANCE_MINUTES=60
BOT_PORTFOLIO_DYNAMIC_SMOOTH_ALPHA=0.35
BOT_PORTFOLIO_DYNAMIC_MIN_WEIGHT=0.05
BOT_PORTFOLIO_DYNAMIC_MAX_WEIGHT=0.60
BOT_PORTFOLIO_DYNAMIC_POSITIVE_ONLY=1

# --- Spread ---
BOT_MAX_SPREAD_POINTS=25

# --- Market regime (telemetría) ---
# Detecta TRENDING/RANGING/UNCERTAIN → bot_state + Telegram. NO muta filtros solos.
BOT_MARKET_REGIME_ENABLED=1
BOT_MARKET_REGIME_AUTO_APPLY=0
# BOT_MARKET_REGIME_CHECK_INTERVAL_SEC=900
# BOT_REGIME_MIN_HOLD_SECONDS=7200
# BOT_SYMBOL_CONFIG_OVERLAY_DISABLED=0
BOT_SPREAD_DYNAMIC_ENABLED=0
BOT_SPREAD_DYNAMIC_ALPHA=0.15
BOT_SPREAD_DYNAMIC_MULT=1.5

# --- Riesgo por % de balance (1 = activo; 5%% base, el portfolio reparte por peso) ---
BOT_USE_RISK_SIZING=1
BOT_RISK_PER_TRADE_PCT=10
BOT_COOLDOWN_MINUTES=30
# Tras order_send rechazado por el bróker (p. ej. Invalid stops): no reintentar abrir en ese símbolo hasta N s. 0 = desactivado.
BOT_FAILED_ATTEMPT_COOLDOWN_SECONDS=120
# Mínimo entre aperturas en BTC/ETH (símbolos crypto relajados M15). Evita ráfagas aunque el JSON baje cooldown.
BOT_COOLDOWN_MINUTES_CRYPTO_FLOOR=6
# Tope de órdenes abiertas por símbolo en ventana 60m (0 = sin límite global). Crypto: ver BOT_MAX_TRADES_PER_HOUR_CRYPTO_DEFAULT.
BOT_MAX_TRADES_PER_HOUR_PER_SYMBOL=0
BOT_MAX_TRADES_PER_HOUR_CRYPTO_DEFAULT=8

# --- Reinicio / posiciones u órdenes pendientes (MT5) ---
# Si 1: posiciones con magic=0 en los símbolos del bot se consideran gestionadas (BE/trailing + tope de abiertas del bot). Desactivá si conviven otros EAs/manuales con magic 0 en los mismos símbolos.
BOT_TRACK_ZERO_MAGIC_POSITIONS=1
# Si 1: al arrancar cancela órdenes pendientes (limit/stop) con el magic del bot en esos símbolos.
BOT_CANCEL_ORPHAN_PENDING_ON_START=0

# --- Ventana horaria / 24/5 (FX + XAU) ---
# Con BOT_TRADING_WINDOW_ENABLED=1 sin sesiones HH:MM: sólo BOT_START_HOUR/BOT_END_HOUR
# (hora LOCAL del PC, inclusiva; Telegram start/end usa el mismo reloj — no UTC).
# Con BOT_TRADING_WINDOW_SESSIONS o trading_window_sessions por símbolo: franjas HH:MM–HH:MM.
# UTC/GMT ⇒ reloj UTC (útil para stocks US); LOCAL ⇒ hora PC. Las ventanas UTC en Telegram
# también muestran el equivalente local (ej. 13:30–20:00 UTC · 10:30–17:00 local).
BOT_TRADING_WINDOW_ENABLED=0
# BOT_TRADING_WINDOW_SESSIONS=06:00-12:00,13:00-18:00
# BOT_TRADING_WINDOW_TIMEZONE=UTC
BOT_WEEKEND_BLOCK_ENABLED=1
# Símbolos que ignoran el bloqueo de sábado/domingo (coma). Vacío = nadie opera en finde.
# Multi-sesión v1: sin bypass (BTC lun–vie únicamente).
BOT_WEEKEND_TRADE_SYMBOLS=
BOT_FRIDAY_CUTOFF_ENABLED=0
BOT_NEW_TRADE_CUTOFF_ENABLED=0
#
# Multi-sesión (hora LOCAL ART) — ejemplo BTC:
# BOT_TRADING_WINDOW_ENABLED=1
# BOT_TRADING_WINDOW_TIMEZONE=LOCAL
# En BOT_SYMBOL_CONFIG["BTCUSD"]["trading_window_sessions"]:
#   "06:00-09:00,14:00-18:00,21:00-23:00"
# Si preferís ventana fija local sin franjas:
# BOT_TRADING_WINDOW_ENABLED=1
# BOT_START_HOUR=11
# BOT_END_HOUR=16
# BOT_NO_NEW_TRADES_AFTER_HOUR=23
# BOT_NO_NEW_TRADES_AFTER_MINUTE=59

# --- Bloqueo simple por hora local (comma-separated), ej. 14,15 ---
BOT_NEWS_BLOCK_HOURS=

# --- Quiet session filter (FX / metales) ---
# Bloquea entradas NUEVAS en horas de baja liquidez (post-NY close + pre-Europa / Asia).
# Kathy Lien (The Little Book of Currency Trading): Asia session = alto % fake-outs en breakouts.
# Los símbolos listados en EXEMPT_SYMBOLS siguen operando (típicamente cripto 24/7).
# Horas en reloj LOCAL del bot. Multi-sesión v1: sin exempt (BTC no opera 00–05).
# 0 = desactivado (comportamiento clásico).
BOT_QUIET_SESSION_BLOCK_ENABLED=1
BOT_QUIET_SESSION_HOURS=0,1,2,3,4,5
BOT_QUIET_SESSION_EXEMPT_SYMBOLS=

# --- EMA / ADX / volatilidad M15 ---
BOT_EMA_PERIOD_M15=50
BOT_EMA_FAST_M15=50
BOT_EMA_SLOW_M15=200
BOT_ADX_PERIOD_M15=14
BOT_ADX_MIN=20
BOT_MIN_AVG_RANGE_POINTS_M15=0

# Pendiente de cierres M15 (regresión lineal, N velas cerradas): confirma dirección antes de BUY/SELL (allow_flat_h4).
# 0 = sin filtro global (comportamiento anterior). Por símbolo: `price_slope_filter_enabled`, `price_slope_n` en BOT_SYMBOL_CONFIG.
BOT_PRICE_SLOPE_FILTER_ENABLED=0
BOT_PRICE_SLOPE_N=6

# --- Filtros anti-lateral (calidad de entrada) ---
# (1) Range filter: evita operar "en el medio" de un rango reciente en timeframe mayor.
# Útil en crypto cuando lateraliza por horas/días (ej. ETHUSD 2200-2450).
BOT_RANGE_FILTER_ENABLED=0
BOT_RANGE_FILTER_TIMEFRAME=H1
BOT_RANGE_FILTER_LOOKBACK_BARS=24
# 0.30 = bloquea el "medio 60%" del rango (más estricto = menos trades)
BOT_RANGE_FILTER_MID_FRAC=0.30

# (2) Candle filter (M15): requiere vela fuerte (cuerpo grande) y evita velas con mechas largas (rechazo).
BOT_CANDLE_FILTER_ENABLED=0
BOT_CANDLE_BODY_MIN_FRAC=0.60
BOT_CANDLE_WICK_MAX_FRAC=0.35
# Si 1: requiere confirmación de 2 velas (la anterior también en la misma dirección)
BOT_CANDLE_REQUIRE_CONFIRMATION=0

# --- Break-even ---
BOT_BREAK_EVEN_TRIGGER_MONEY=0.5
BOT_BREAK_EVEN_OFFSET_POINTS=0
BOT_TRAIL_TRIGGER_MONEY=1.0
BOT_TRAIL_NEW_SL_MONEY=0.5
BOT_TRAIL_NEW_TP_MONEY=1.2

# --- SL a precio de entrada al abrir (experimental) ---
# 1: tras calcular SL/TP "normales", fuerza el SL al precio de llenado (TP se mantiene; si hace conflicto, TP se anula al abrir).
# Override en BOT_SYMBOL_CONFIG JSON por símbolo: "open_sl_at_entry": true
BOT_OPEN_SL_AT_ENTRY=0
# Si el bróker rechaza el SL: reintentar con SL a precio±N*point (N=0,1,… hasta este máximo). Override JSON: "open_sl_at_entry_max_extra_points".
BOT_OPEN_SL_AT_ENTRY_MAX_EXTRA_POINTS=400
# Primer extra_points a probar si el bróker exige distancia mínima (además se usa trade_stops_level del símbolo).
BOT_OPEN_SL_AT_ENTRY_MIN_EXTRA_POINTS=0

# --- Escalón USD: según pico de ganancia flotante, asegurar de a N USD (live) ---
# 1: cada vez que el beneficio pico (desde apertura) supere N * step, se mueve el SL
#    para asegurar aprox. N * secure (modelo lineal con tick value). Requiere peak en memoria por ticket.
# Si BOT_PROFIT_LOCK_ENABLED=1 y BOT_SKIP_TIGHT_TRAIL_WHEN_PROFIT_LOCK=1, se omite el tight trail ATR (evita pelearse con la escalera).
# Overrides JSON: "profit_lock_enabled", "profit_lock_step_money", "profit_lock_secure_money"
BOT_PROFIT_LOCK_ENABLED=0
BOT_PROFIT_LOCK_STEP_MONEY=1.0
BOT_PROFIT_LOCK_SECURE_MONEY=1.0

# --- Escalera USD en vivo (SL): ~riesgo inicial en $ → espera → BE → +$1..+$N con pausas ---
# Si está activa, el bot NO usa open_sl_at_entry ni BE/trailing/profit_lock clásicos (evita cierres al instante).
# Con BOT_USD_SL_LADDER_ENABLED=1 aplica a todos los símbolos del bot (no se puede apagar por activo en JSON).
# Overrides por símbolo en BOT_SYMBOL_CONFIG → usd_sl_ladder_initial_sl_money, usd_ladder_wait_be_seconds, usd_ladder_step_seconds, usd_ladder_max_lock_usd
BOT_USD_SL_LADDER_ENABLED=1
BOT_USD_SL_LADDER_INITIAL_SL_USD=0.8
BOT_USD_LADDER_WAIT_BE_SECONDS=180
BOT_USD_LADDER_STEP_SECONDS=120
# 0 = sin tope en locks USD; >0 = último escalón +$N asegurado (ej. 10 = hasta +$10).
BOT_USD_LADDER_MAX_LOCK_USD=0
BOT_SKIP_TIGHT_TRAIL_WHEN_PROFIT_LOCK=1

# --- Backtest: tope de equity para el risk %% (lote) sin recompensar a lo infinito ---
# Dejar vacío = compounding sobre balance simulado completo. Un número = teto fijo
# (ej. igual al initial balance de backtest) para aproximar cuenta real. Sólo backtest.py.
# BOT_BACKTEST_MAX_EQUITY_RISK=100

# --- (A) Anti-chase / exhaustion candle filter ---
# 1 = activo. Si la última vela M15 cerrada tiene rango > mult * ATR(period), no entra.
# Evita perseguir movimientos agotados (velas de exhausto) que suelen revertir.
# Override por símbolo: "anti_chase_enabled", "anti_chase_atr_mult", "anti_chase_atr_period".
BOT_ANTI_CHASE_ENABLED=1
BOT_ANTI_CHASE_ATR_PERIOD=20
BOT_ANTI_CHASE_ATR_MULT=2.0
# Piso del mult en BTC/ETH (no usar por debajo; evita quedar bloqueado en velas ~2.0x ATR).
BOT_ANTI_CHASE_ATR_MULT_CRYPTO_FLOOR=2.65

# --- (B) Filter exit por pérdida de momentum ---
# Cierra a mercado una posición EN GANANCIA cuando el tren/momentum se rompe.
# Por defecto requiere ambas: ADX por debajo del umbral Y EMA en contra del lado de la posición.
BOT_FILTER_EXIT_ENABLED=1
# 0 = usa BOT_ADX_MIN. >0 = umbral específico para este filtro.
BOT_FILTER_EXIT_ADX_MIN=0
# 1 = exige que EMA también flipe contra la posición (más conservador, menos salidas falsas).
BOT_FILTER_EXIT_REQUIRE_EMA_REVERSAL=1
# Sólo filter-exit si profit >= este valor (USD). 0 = cualquier BE+.
BOT_FILTER_EXIT_MIN_PROFIT_MONEY=0

# --- (C) Tight trailing stop post-profit (ATR) ---
# Una vez en ganancia >= TRIGGER, mueve el SL a ATR(period)*mult del precio actual.
# Sólo aprieta SL (monotónico); deja TP libre para que corra.
# Override por símbolo: "tight_trail_enabled", "tight_trail_trigger_money", "tight_trail_atr_mult".
BOT_TIGHT_TRAIL_ENABLED=1
BOT_TIGHT_TRAIL_TRIGGER_MONEY=2.0
BOT_TIGHT_TRAIL_ATR_PERIOD=14
BOT_TIGHT_TRAIL_ATR_MULT=1.2

# --- (D) SL/TP adaptativo por ATR (Way of the Turtle Ch.8-10) ---
# Cuando está activo, SL y TP en la apertura del trade se calculan desde ATR:
#   SL_distance = ATR * sl_atr_mult    (Turtle: 2N stop → sl_mult=2.0)
#   TP_distance = ATR * tp_atr_mult    (default 4.0 = 2R target)
# El lot se sigue calculando con risk_per_trade_pct: si ATR sube → SL se aleja →
# lot baja automáticamente. El riesgo $ por trade queda constante en todo régimen.
# Si ATR no está disponible, fallback a los sl_points/tp_points fijos (seguro).
# Override por símbolo: "sl_tp_atr_enabled", "sl_atr_mult", "tp_atr_mult",
# "sl_tp_atr_timeframe", "sl_tp_atr_period", "sl_tp_atr_min_points".
# sl_tp_atr_enabled en el JSON por símbolo pisa el global: podés BOT_SL_TP_ATR_ENABLED=0 y activar solo p. ej. ETHUSD.
BOT_SL_TP_ATR_ENABLED=0
BOT_SL_TP_ATR_TIMEFRAME=M15
BOT_SL_TP_ATR_PERIOD=14
BOT_SL_ATR_MULT=2.0
BOT_TP_ATR_MULT=4.0
# Floor (points) para el SL cuando la volatilidad colapsa. 0 = sin floor.
BOT_SL_TP_ATR_MIN_POINTS=0

# --- (E) Correlation / exposure caps (Way of the Turtle Ch.8 pp.118-119) ---
# Define grupos de símbolos que tienden a moverse juntos (correlacionados). Cuando
# un grupo llega a MAX_POSITIONS_PER_GROUP posiciones abiertas, cualquier nueva
# entrada en símbolos del grupo se bloquea (se emite un evento CORRELATION_SKIP).
# Por qué: tres shorts USD simultáneos son efectivamente UN trade con 3x el riesgo.
# Con risk_per_trade_pct=3 y max_per_group=2 → máximo ~6% de riesgo USD simultáneo.
# 0 desactiva el filtro. Las claves del JSON son nombres libres (para el log).
BOT_MAX_POSITIONS_PER_GROUP=0
BOT_CORRELATION_GROUPS={"USD_BASE":["GBPUSD","USDJPY","NZDJPY","XAUUSD"],"CRYPTO":["BTCUSD","ETHUSD"]}
