# =============================================================================
# 1) Copiá este archivo a `.env` y completá valores reales.
# 2) NO subas `.env` a git (está en .gitignore).
# 3) El bot y flask_dashboard cargan `.env` automáticamente (python-dotenv).
#    Si ya definiste una variable en PowerShell, esa tiene prioridad.
# 4) El MCP `ccxt` (Cursor) también lee este archivo, pero SOLO exporta `CCXT_MCP_*`
#    al proceso de Node. MT5/Telegram nunca se reenvían a ccxt-mcp.
# =============================================================================

# --- CCXT MCP (Cursor: datos de mercado crypto; NO órdenes) ---
# Público (tickers/OHLCV) funciona con estas claves vacías.
# Credenciales opcionales = lecturas privadas (balance). Trading está forzado a off.
# CCXT_MCP_EXCHANGE=binance
# CCXT_MCP_APIKEY=
# CCXT_MCP_SECRET=
# CCXT_MCP_PASSWORD=
# CCXT_MCP_UID=
# CCXT_MCP_SANDBOX=1
# No uses CCXT_MCP_TRADING=1 ni live: el launcher del workspace lo ignora.

# --- MT5 (obligatorio) ---
MT5_LOGIN=<ACCOUNT_LOGIN>
MT5_PASSWORD=<ACCOUNT_PASSWORD>
MT5_SERVER=XBTFX-MetaTrader5
# El bot, el daemon de ticks y el minero rechazan un terminal cuyo server o
# company no contenga XBTFX. MT5_XBTFX_ONLY=0 abre el candado (no recomendado).
# MT5_XBTFX_ONLY=1
# MT5_BROKER_SERVER_MARKERS=XBTFX

# --- Telegram (opcional): alertas si MT5 se cae / errores en el loop / arranque y parada / prueba en dashboard ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# User-account export (Telethon). Never commit real values.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_EXPORT_CHANNEL=t.me/YourChannel
# TELEGRAM_NOTIFY_START=1
# TELEGRAM_NOTIFY_STOP=1
# TELEGRAM_NOTIFY_SIGNALS=0      # si 1: avisar cuando haya señal BUY/SELL (anti-spam ~15 min por símbolo)
# TELEGRAM_NOTIFY_TRADE_OPEN=0   # aviso al abrir orden (entrada). Default 0.
# TELEGRAM_NOTIFY_TRADE_CLOSE=0  # aviso al cerrar (SL/TP/manual, PnL del deal). Default 0.
# TELEGRAM_NOTIFY_SESSION_WINDOW=0  # aviso al inicio/fin de ventana horaria. Default 0.
# TELEGRAM_NOTIFY_WATCHER_SL=0   # aviso cuando el watcher modifica el SL. Default 0.
# TELEGRAM_FORWARD_CHANNEL=1     # reenviar NUEVA SENAL de SantinoCripto al chat del bot
# TELEGRAM_TIMEOUT=12

# --- Símbolos (comma-separated) ---
# Rotation engine (default ON): 79 cryptos XBTFX. Override only with BOT_ROTATION_KEEP_ENV_SYMBOLS=1.
# BOT_SYMBOLS=BTCUSD!,ETHUSD!
BOT_SYMBOLS=

# --- Motor de rotación / consenso (único motor; H4+M15 retirado 2026-10-06) ---
# BOT_DRY_RUN=1                 # 1 = solo señales. 0 + PAPER_DEMO_LIVE=1 = órdenes en demo XBTFX
# PAPER_DEMO_LIVE=0             # 1 = order_send a la terminal demo (nunca cuenta real)
# Una orden sale si 4/5 módulos + vetos HTF/pullback/RSI-rango + size ≤ 0.50 USD + cuota hora + un slot + spread ok.
# Módulos: htf (M15 EMA50), momentum_short, intermarket, vol_bands, structure. Flow XBTFX no vota.
# Skips extra: veto_htf, sin_pullback, rsi_rango, spread_caro, spread_cubre_stop.
# why_open=consenso_4_5  comment broker=rot_4_5
# Postgres (md_bars) no decide aperturas; es Lab / ingest, no el motor.
# BOT_ENSEMBLE_MIN_AGREE=4      # de 5 módulos
# BOT_MAX_RISK_USD=0.50         # tope SL/TP en USD; Kelly solo achica
# BOT_MAX_OPENS_PER_HOUR=60
# Skip si el spread USD > esta fracción del riesgo, o si el spread cubre el stop.
# BOT_ROTATION_MAX_SPREAD_USD_FRAC=0.10
# Tras 5 min: take si profit > 0.01, loss si < -0.0001; CLOSE_ALL cierra también la banda (stale_time).
# BOT_ROTATION_STALE_SECONDS=300
# BOT_ROTATION_STALE_TINY_LOSS_USD=-0.0001
# BOT_ROTATION_STALE_TAKE_USD=0.01
# BOT_ROTATION_STALE_CLOSE_ALL=1
# Snapshot del neto flotante magic 260414 cada N segundos (0 = off).
# BOT_ROTATION_BOOK_SNAPSHOT_SECONDS=60
# Aplanar el libro si el neto flotante ≥ 0.50, ≥2 tickets y el más joven ≥ 10 min. 0 USD = off.
# BOT_ROTATION_BOOK_HARVEST_USD=0.50
# BOT_ROTATION_BOOK_HARVEST_MIN_AGE_SECONDS=600
# BOT_ROTATION_BOOK_HARVEST_MIN_OPEN=2
# BOT_ROTATION_KEEP_ENV_SYMBOLS=0

# BTCUSD! spread 1350 pts on a −$4.32 SL. Caps BOT_SYMBOL_CONFIG max_spread_points. 0 = off.
# BOT_BTCUSD_MAX_SPREAD_POINTS=1000

# Magic que leen el dashboard y los reportes. El bot usa 260414 fijo (Config en bot_mt5.py).
# BOT_MAGIC=260414

# --- Operación base ---
BOT_LOT=0.01
BOT_POLL_SECONDS=15
# Entre ciclos completos (poll), volver a leer posiciones y ajustar SL/TP al menos cada N segundos.
BOT_MANAGE_POSITIONS_INTERVAL_SECONDS=5
BOT_MAX_OPEN_TRADES=60
BOT_DAILY_LOSS_LIMIT=-25.0
# Momento cero del /lab (cierres bot+manual y forense del log). Default 2026-09-24.
# BOT_LAB_SINCE=2026-09-24
# Primer día del motor de rotación (dashboard de cierres crypto). Default 2026-09-29.
# BOT_ROTATION_SINCE=2026-09-29

# --- Monthly loss limit (Elder's 6% Rule) ---
# Al superar `pct%` del balance al inicio del mes (loss realizado +
# riesgo abierto si se incluye), el bot deja de abrir trades hasta
# el 1 del próximo mes. Si include_open_risk=true, suma la pérdida
# potencial si cada posición abierta llega a su SL (más conservador,
# pero requiere SL definido en todas las posiciones).
BOT_MONTHLY_LOSS_LIMIT_ENABLED=true
BOT_MONTHLY_LOSS_LIMIT_PCT=6.0
BOT_MONTHLY_LOSS_LIMIT_INCLUDE_OPEN_RISK=true

# --- Pyramiding (varias órdenes por mismo activo) ---
# 1 = desactivado. >1 = permitir hasta N posiciones por símbolo (recomendado <=3).
BOT_MAX_POSITIONS_PER_SYMBOL=1
# 1 = sólo abrir nueva capa si TODAS las posiciones previas en el símbolo ya tienen SL en BE o mejor.
BOT_PYRAMIDING_REQUIRE_BE=1
# Distancia mínima en points respecto al último entry mismo-lado para abrir nueva capa (0 = off).
BOT_PYRAMIDING_MIN_SEPARATION_POINTS=0
# Override por símbolo: agregar "max_positions_per_symbol", "pyramiding_require_be" o
# "pyramiding_min_separation_points" dentro de BOT_SYMBOL_CONFIG si querés ajustar por activo.

# --- Per-symbol overrides (JSON en UNA línea; vacío = usar defaults globales) ---
# Claves que el bot lee: max_spread_points, max_positions_per_symbol, pyramiding_require_be,
# pyramiding_min_separation_points.
# lot / sl_money / tp_money / max_trades_per_hour_per_symbol los pisa la rotación en cada apertura.
# Ejemplo:
# BOT_SYMBOL_CONFIG={"BTCUSD!":{"max_spread_points":5000}}
BOT_SYMBOL_CONFIG=

# --- Portfolio mode (pesos) ---
# Solo llena el bloque `portfolio` de bot_state.json; no cambia el lote de la rotación.
BOT_PORTFOLIO_ENABLED=1
BOT_PORTFOLIO_WEIGHTS={"GBPUSD":0.1667,"USDJPY.":0.1667,"NZDJPY":0.1667,"XAUUSD.":0.1667,"BTCUSD!":0.1666,"ETHUSD!":0.1666}
# 1 = force weights to sum to 1 among BOT_SYMBOLS. 0 = keep raw sleeves (unused budget stays unused).
BOT_PORTFOLIO_RENORMALIZE=1

# --- Portfolio dinámico (live): rebalance por PnL realizado (history deals) ---
BOT_PORTFOLIO_DYNAMIC_ENABLED=0
BOT_PORTFOLIO_DYNAMIC_LOOKBACK_DAYS=14
BOT_PORTFOLIO_DYNAMIC_REBALANCE_MINUTES=60
BOT_PORTFOLIO_DYNAMIC_SMOOTH_ALPHA=0.35
BOT_PORTFOLIO_DYNAMIC_MIN_WEIGHT=0.05
BOT_PORTFOLIO_DYNAMIC_MAX_WEIGHT=0.60
BOT_PORTFOLIO_DYNAMIC_POSITIVE_ONLY=1

# --- Spread ---
BOT_MAX_SPREAD_POINTS=25

BOT_SPREAD_DYNAMIC_ENABLED=0
BOT_SPREAD_DYNAMIC_ALPHA=0.15
BOT_SPREAD_DYNAMIC_MULT=1.5

# --- Lote / reintentos ---
# Tope de margen de UNA orden vs margen libre (0 = off). 0.5 deja aire ante ruido.
BOT_LOT_MAX_MARGIN_FRAC=0.5
# Tras order_send rechazado por el bróker (p. ej. Invalid stops): no reintentar abrir en ese símbolo hasta N s. 0 = desactivado.
BOT_FAILED_ATTEMPT_COOLDOWN_SECONDS=120
# Tope de órdenes abiertas por símbolo en ventana 60m (0 = sin límite global). Crypto: ver BOT_MAX_TRADES_PER_HOUR_CRYPTO_DEFAULT.
BOT_MAX_TRADES_PER_HOUR_PER_SYMBOL=0
BOT_MAX_TRADES_PER_HOUR_CRYPTO_DEFAULT=8

# --- Reinicio / posiciones u órdenes pendientes (MT5) ---
# Si 1: posiciones con magic=0 en los símbolos del bot se consideran gestionadas (BE/trailing + tope de abiertas del bot). Desactivá si conviven otros EAs/manuales con magic 0 en los mismos símbolos.
BOT_TRACK_ZERO_MAGIC_POSITIONS=1
# Si 1: al arrancar cancela órdenes pendientes (limit/stop) con el magic del bot en esos símbolos.
BOT_CANCEL_ORPHAN_PENDING_ON_START=0

# --- Horario ---
# La rotación opera 24/7: el código fuerza a off la ventana horaria, el cutoff de viernes,
# el cutoff de nuevas entradas y el bloqueo de sesión quieta, y todo el universo cuenta como
# símbolo de fin de semana. BOT_TRADING_WINDOW_*, BOT_FRIDAY_CUTOFF_ENABLED,
# BOT_NEW_TRADE_CUTOFF_ENABLED, BOT_QUIET_SESSION_* y BOT_WEEKEND_TRADE_SYMBOLS no tienen efecto.

# --- Bloqueo simple por hora local (comma-separated), ej. 14,15 ---
BOT_NEWS_BLOCK_HOURS=

# --- Excepciones manuales ---
# Tickets en manual_exceptions.txt (raíz del repo) no se tocan.
# BOT_MANUAL_EXCEPTIONS_FILE=  # opcional; default = ./manual_exceptions.txt

# --- (F) Data layer local: Docker Postgres + Redis (infra/docker-compose.yml) ---
# Puertos NO default a proposito: 5432/6379 los ocupa el stack poly-trader.
# Levantar:  docker compose --env-file .env -f infra/docker-compose.yml up -d
# MT5_PG_PASSWORD es obligatorio (compose falla si falta). Generar uno local.
MT5_PG_HOST=127.0.0.1
MT5_PG_PORT=5433
MT5_PG_USER=metatrader
MT5_PG_PASSWORD=
MT5_PG_DB=metatrader
MT5_PG_POOL_MIN=1
MT5_PG_POOL_MAX=8
MT5_REDIS_HOST=127.0.0.1
MT5_REDIS_PORT=6380
MT5_REDIS_DB=0
MT5_REDIS_MAXMEMORY=256mb

# --- (G) Retencion / TTL de market data ---
# md_ticks y md_bars estan particionadas por dia UTC. El janitor DROPea
# particiones enteras (no DELETE): con ticks de alta frecuencia un DELETE
# infla el heap mas rapido de lo que autovacuum lo recupera.
MT5_TICK_TTL_HOURS=48
MT5_BAR_TTL_DAYS=30
MT5_JANITOR_INTERVAL_MINUTES=30

# --- (H) Daemon de ingesta de ticks MT5 (mt5_tick_daemon.py) ---
# Proceso aparte del bot. Si se cae, el bot sigue operando igual.
# Vacio en SYMBOLS + rotacion ON = las 79 CFD (CRYPTO_UNIVERSE), no BOT_SYMBOLS.
# Lista explicita pisa.
# La API MetaTrader5 es sincronica y no tiene callbacks: el daemon pollea
# copy_ticks_from con cursor, asi no se pierden ticks entre polls.
MT5_TICK_DAEMON_SYMBOLS=
MT5_TICK_POLL_SECONDS=1.0
MT5_TICK_BATCH_MAX=5000
MT5_TICK_PERSIST_ENABLED=1
MT5_TICK_PUBLISH_ENABLED=1
# Stream Redis acotado (XADD MAXLEN ~) para replay corto, ademas del pub/sub.
# 0 desactiva el stream y deja solo pub/sub.
MT5_TICK_STREAM_MAXLEN=10000
MT5_BAR_TIMEFRAMES=M1,M5,M15
MT5_BAR_POLL_SECONDS=30
MT5_BAR_BACKFILL=500

# --- (I) Alpha engine multi-factor (shadow-only) ---
# NO ejecuta ordenes: solo escribe scores en la tabla alpha_scores.
# Universo = el mismo que el tick daemon (79 en rotacion).
# Pasar esto a ejecucion real requiere el gate de doble backtest
# (Vibe-Trading + QuantConnect) con nota explicita de risk-quant.
MT5_ALPHA_ENABLED=0
MT5_ALPHA_TIMEFRAME=M15
MT5_ALPHA_INTERVAL_SECONDS=30
MT5_ALPHA_BARS=300
# Pesos de los 4 factores. Se renormalizan si no suman 1.
MT5_ALPHA_W_MOMENTUM=0.35
MT5_ALPHA_W_VOLATILITY=0.15
MT5_ALPHA_W_ZSCORE=0.30
MT5_ALPHA_W_FLOW=0.20
MT5_ALPHA_ZSCORE_LOOKBACK=50
# Costos restados al edge bruto (en points del simbolo). El spread se toma
# en vivo; comision y slippage son estimados del broker.
MT5_ALPHA_COMMISSION_POINTS=0
MT5_ALPHA_SLIPPAGE_POINTS=0
# Umbral minimo de |score| para registrar una direccion distinta de NONE.
MT5_ALPHA_MIN_SCORE=0.15
# q vive dentro de features (jsonb). No es una tasa de acierto calibrada y
# no entra al Kelly del bot en vivo.

# --- (K) Exposure caps por divisa ---
# Descompone cada simbolo en base/quote y limita la exposicion NETA y
# BRUTA por divisa, en lotes. 0 = desactivado.
BOT_CURRENCY_EXPOSURE_ENABLED=0
BOT_MAX_NET_EXPOSURE_PER_CURRENCY=0
BOT_MAX_GROSS_EXPOSURE_PER_CURRENCY=0
# Simbolos que no parsean como 6 letras FX (cripto, metales, indices).
# Formato: {"SIMBOLO":["BASE","QUOTE"]}
BOT_CURRENCY_SYMBOL_OVERRIDES={"BTCUSD!":["BTC","USD"],"ETHUSD!":["ETH","USD"],"XAUUSD.":["XAU","USD"]}

# --- (L) Manual trade pattern miner (solo lectura) ---
# Journal de cierres con magic 0 en manual_trade_journal. No envia ordenes
# y no esta cableado al loop de bot_mt5.py. Tabla persistente: el janitor
# de TTL no la toca. Los resumenes automaticos van a manual_miner_reports
# (tampoco se purga) y a manual_miner.log. No reescribe pesos ni el Kelly.
#   py manual_miner_daemon.py
#   py -m trading.application.manual_pattern_miner --once
#   py -m trading.application.manual_pattern_miner --report
MT5_MANUAL_MINER_LOOKBACK_DAYS=14
MT5_MANUAL_MINER_TIMEFRAME=M15
MT5_MANUAL_MINER_BARS=120
MT5_MANUAL_MINER_INTERVAL_SECONDS=300
MT5_MANUAL_MINER_REPORT_EVERY=10
MT5_MANUAL_MINER_STAT_MIN=30
MT5_MANUAL_MINER_MIN_N=3
MT5_MANUAL_MINER_DASHBOARD_LAG_SECONDS=900
MT5_MANUAL_MINER_DASHBOARD_PATH=bot_state.json

# --- (M) Gobierno: Gemini nocturno + Cursor SDK (nunca en order_send) ---
# Plan: trading/docs/GOVERNANCE_PLAN.md
# Google AI Studio → API key. El SDK Python (google-genai) lee GOOGLE_API_KEY.
# GEMINI_API_KEY es alias; si está GOOGLE_API_KEY, no hace falta duplicar.
# El job nocturno no corre si GEMINI_NIGHTLY_ENABLED=0 o falta la clave.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_NIGHTLY_ENABLED=0
# Cursor chat en este repo no usa esta clave. Solo el SDK programático (@cursor/sdk).
CURSOR_API_KEY=
# Flatten del magic 260414 cuando ya saltó BOT_DAILY_LOSS_LIMIT. 0 = solo no abrir (hoy).
# Con 1: cierra el libro una vez, escribe kill_switch.halt y no abre (ni tras restart) hasta clear manual:
# borrar kill_switch.halt o crear kill_switch.clear. Un halt ilegible también bloquea.
BOT_KILL_SWITCH_FLATTEN=0
# 0 = ignora un kill_switch.halt existente mientras siga en 0 (no lo borra) y nunca aplana.
BOT_KILL_SWITCH_ARMED=1
# Telegram extra (token/chat ya están arriba). Default off para no spamear votos.
TELEGRAM_NOTIFY_KILL_SWITCH=0
TELEGRAM_NOTIFY_DAILY_REPORT=0
# Aviso si MT5 sigue desconectado tras el reintento (dedup 3 min).
TELEGRAM_NOTIFY_ERROR=0
# Resumen de la propuesta Gemini semanal (run_reports.ps1 -Mode Weekly).
TELEGRAM_NOTIFY_NIGHTLY=0

# --- (N) Swing diario Donchian 20/10 + SMA200 (swing_daily.py, NO aprobado para vivo) ---
# Runbook: trading/docs/SWING_ENGINE.md. Dry-run por defecto. Órdenes solo con DRY_RUN=0 + DEMO_LIVE=1,
# cuenta XBTFX demo y sin actividad del magic de rotación (posiciones o deals en BOT_SWING_ROTATION_LOOKBACK_H).
# En Exness (servidor con "Exness") el swing es siempre dry-run, usa BTCUSDm/ETHUSDm y
# archivos swing_exness_* (estado, halt, log). Ver SWING_ENGINE.md seccion Exness.
BOT_SWING_DRY_RUN=1
BOT_SWING_DEMO_LIVE=0
BOT_SWING_MAGIC=260501
BOT_ROTATION_MAGIC=260414
# Terminal y cuenta demo propios (vacío = terminal por defecto, que hoy es la de rotación → entradas bloqueadas).
BOT_SWING_MT5_PATH=
BOT_SWING_MT5_LOGIN=
BOT_SWING_MT5_PASSWORD=
BOT_SWING_MT5_SERVER=
# Riesgo por trade (fracción del equity hasta el mínimo de 10 días), tope de posiciones, halt por drawdown.
BOT_SWING_RISK_FRAC=0.005
BOT_SWING_MAX_POSITIONS=10
BOT_SWING_MAX_DD=0.35
# Minutos después de 00:00 UTC para decidir sobre la vela diaria cerrada.
BOT_SWING_RUN_AFTER_MIN=10
# Vacío = las 79 de CRYPTO_UNIVERSE.
BOT_SWING_SYMBOLS=
BOT_SWING_STATE=swing_state.json
BOT_SWING_HALT=swing_kill_switch.halt
BOT_SWING_LOG=swing_trades.log
# 1 = un kill_switch.halt de rotación también bloquea entradas swing (salidas siguen).
BOT_SWING_HONOR_ROTATION_HALT=1
# Entradas bloqueadas si el magic de rotación tuvo posiciones o deals en estas últimas horas.
BOT_SWING_ROTATION_LOOKBACK_H=2
